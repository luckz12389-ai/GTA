------------------------------------------------ MODO CELULAR (nunca PC)
local injecting = false
local injectToken = 0
local held = false
local controls, origChanged

pcall(function()
	local pm = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5))
	controls = pm:GetControls()
	origChanged = controls.OnLastInputTypeChanged
	local pcTypes = {
		[Enum.UserInputType.MouseButton1] = true,
		[Enum.UserInputType.MouseButton2] = true,
		[Enum.UserInputType.MouseButton3] = true,
		[Enum.UserInputType.MouseWheel] = true,
		[Enum.UserInputType.MouseMovement] = true,
		[Enum.UserInputType.Keyboard] = true,
	}
	controls.OnLastInputTypeChanged = function(self, t)
		if injecting and pcTypes[t] then return end
		return origChanged(self, t)
	end
end)

local function sendTouch(state, p)
	if not VIM then return false end
	return pcall(function()
		VIM:SendTouchEvent(TOUCH_ID, state, p.X, p.Y)
	end)
end

-- manda um toque fora da tela só para o Roblox voltar ao modo celular
local function backToTouch()
	if VIM then
		sendTouch(0, Vector2.new(-100, -100))
		task.wait(0.02)
		sendTouch(2, Vector2.new(-100, -100))
	end
	pcall(function()
		if controls and origChanged then origChanged(controls, Enum.UserInputType.Touch) end
	end)
	pcall(function() UIS.MouseIconEnabled = false end)
end

local function startInject()
	injecting = true
	injectToken += 1
end
local function endInject()
	local t = injectToken
	task.delay(0.25, function()
		if t == injectToken and not held then
			injecting = false
			backToTouch()
		end
	end)
end

------------------------------------------------ IMAGENS (GitHub)
local function download(url)
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and body and #body > 0 then return body end
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if req then
		local ok2, res = pcall(req, { Url = url, Method = "GET" })
		if ok2 and res and res.StatusCode == 200 then return res.Body end
	end
	return nil
end

local function applyImage(obj, url, fname)
	if not (writefile and getcustomasset) then return false end
	local bytes = download(url)
	if bytes then pcall(writefile, fname, bytes) end
	local okExists = isfile and isfile(fname)
	if okExists == false then return false end
	local ok, asset = pcall(getcustomasset, fname)
	if not ok or not asset then return false end
	obj.Image = asset
	pcall(function() ContentProvider:PreloadAsync({ obj }) end)
	return obj.IsLoaded
end

