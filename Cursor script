------------------------------------------------ TRAVAR A CÂMERA ENQUANTO O DEDO ESTÁ NO MOUSE
local camLocked, prevCamType = false, nil
local function lockCamera()
	if camLocked then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	camLocked = true
	prevCamType = cam.CameraType
	cam.CameraType = Enum.CameraType.Scriptable
end
local function unlockCamera()
	if not camLocked then return end
	camLocked = false
	local cam = workspace.CurrentCamera
	if cam and prevCamType then cam.CameraType = prevCamType end
end

local lockInput
local function isPress(i)
	return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
end
local function lockOn(i)
	if isPress(i) and not lockInput then
		lockInput = i
		lockCamera()
	end
end
for _, obj in ipairs({ body, leftZone, rightZone }) do
	connect(obj.InputBegan, lockOn)
end

------------------------------------------------ CLIQUE
local touchMode = nil -- nil = ainda não testou | true = toque funciona | false = usa mouse
local usedTouch = false
local usedMouse = false
local MOVE_PENDING = false

local function mouseMove()
	local p = clickPoint()
	pcall(VIM.SendMouseMoveEvent, VIM, p.X, p.Y, game)
end

local function mouseButton(down)
	local p = clickPoint()
	pcall(VIM.SendMouseButtonEvent, VIM, p.X, p.Y, 0, down, game, 0)
end

-- Reserva (sem VirtualInputManager)
local function fallbackClick()
	local inset = GuiService:GetGuiInset()
	local p = clickPoint()
	local list = playerGui:GetGuiObjectsAtPosition(p.X - inset.X, p.Y - inset.Y)
	for _, o in ipairs(list) do
		if not o:IsDescendantOf(gui) then
			if o:IsA("TextBox") then
				o:CaptureFocus()
				return
			elseif o:IsA("GuiButton") then
				if firesignal then
					pcall(firesignal, o.MouseButton1Down)
					pcall(firesignal, o.MouseButton1Click)
					pcall(firesignal, o.Activated)
					pcall(firesignal, o.MouseButton1Up)
				end
				return
			end
		end
	end
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(p.X, p.Y)
	local params = RaycastParams.new()
	if player.Character then params.FilterDescendantsInstances = { player.Character } end
	local r = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	if r and r.Instance then
		local cd = r.Instance:FindFirstChildWhichIsA("ClickDetector", true)
			or (r.Instance.Parent and r.Instance.Parent:FindFirstChildWhichIsA("ClickDetector", true))
		if cd and fireclickdetector then pcall(fireclickdetector, cd) end
		local pp = r.Instance:FindFirstChildWhichIsA("ProximityPrompt", true)
			or (r.Instance.Parent and r.Instance.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
		if pp and fireproximityprompt then pcall(fireproximityprompt, pp) end
	end
	local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
	if tool then tool:Activate() end
end

local function shrink(on)
	local sz = on and (CURSOR_SIZE - 4) or CURSOR_SIZE
	TweenService:Create(cursor, TweenInfo.new(0.08), { Size = UDim2.fromOffset(sz, sz) }):Play()
end

local function pressDown()
	held = true
	shrink(true)
	usedTouch, usedMouse = false, false
	if not VIM then return end

	if touchMode ~= false then
		local seen = false
		local c = UIS.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.Touch then seen = true end
		end)
		sendTouch(0, clickPoint())
		if touchMode == nil then
			task.wait(0.12)
			touchMode = seen
			if not seen then sendTouch(2, clickPoint()) end
		end
		c:Disconnect()
		if touchMode then
			usedTouch = true
			return
		end
	end

	-- plano B: clique de mouse (com proteção contra o modo PC)
	usedMouse = true
	startInject()
	mouseMove()
	task.wait(0.03)
	mouseButton(true)
end

local function pressUp()
	held = false
	shrink(false)
	if usedTouch then
		sendTouch(2, clickPoint())
	elseif usedMouse then
		mouseButton(false)
		endInject()
	elseif not VIM then
		fallbackClick()
	end
	usedTouch, usedMouse = false, false
end

local function setCursor(p)
	local s = gui.AbsoluteSize
	cursorPos = Vector2.new(
		math.clamp(p.X, 0, math.max(s.X - 1, 1)),
		math.clamp(p.Y, 0, math.max(s.Y - 1, 1))
	)
	cursor.Position = UDim2.fromOffset(cursorPos.X, cursorPos.Y)
	if held then
		if usedTouch then
			sendTouch(1, clickPoint()) -- arrasta enquanto segura
		elseif usedMouse then
			mouseMove()
		end
	end
end
setCursor(gui.AbsoluteSize / 2)

-- Direito = clica
connect(rightZone.InputBegan, function(i)
	if isPress(i) and not held then
		pressDown()
		task.wait(0.07)
		pressUp()
	end
end)

-- Esquerdo = segura (toque de novo para soltar)
connect(leftZone.InputBegan, function(i)
	if isPress(i) then
		if held then pressUp() else pressDown() end
	end
end)

------------------------------------------------ MOVER O CURSOR (deslizar o dedo no mouse)
local pad, padLast
local accum = Vector2.new(0, 0)

local function same(tracked, input)
	return tracked == input
		or (tracked.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
end

connect(body.InputBegan, function(i)
	if isPress(i) then
		pad = i
		padLast = Vector2.new(i.Position.X, i.Position.Y)
		accum = Vector2.new(0, 0)
	end
end)

connect(UIS.InputChanged, function(input)
	if pad and same(pad, input) then
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		accum += pos - padLast
		padLast = pos
	end
end)

-- aplica o movimento uma vez por frame, com aceleração leve
connect(RunService.RenderStepped, function()
	if accum.Magnitude > 0 then
		local d = accum
		accum = Vector2.new(0, 0)
		local gain = SENS * (1 + math.clamp(d.Magnitude / 25, 0, 1.5) * ACEL / 1.5)
		setCursor(cursorPos + d * gain)
	end
end)

connect(UIS.InputEnded, function(input)
	if pad and (input == pad or (isPress(input) and pad.UserInputType == input.UserInputType)) then
		pad = nil
		accum = Vector2.new(0, 0)
	end
	if lockInput and (input == lockInput or (isPress(input) and lockInput.UserInputType == input.UserInputType)) then
		lockInput = nil
		unlockCamera()
	end
end)

